# check attaches the src attribute of the offending wire or cell to its warnings
read_rtlil <<EOF
module \top
  attribute \src "test.v:3.1-3.20"
  wire \undriven
  attribute \src "test.v:4.1-4.20"
  wire \multi
  attribute \src "test.v:5.1-5.20"
  wire output 1 \y
  attribute \src "test.v:6.1-6.30"
  cell $not \n1
    parameter \A_SIGNED 0
    parameter \A_WIDTH 1
    parameter \Y_WIDTH 1
    connect \A \undriven
    connect \Y \multi
  end
  attribute \src "test.v:7.1-7.30"
  cell $not \n2
    parameter \A_SIGNED 0
    parameter \A_WIDTH 1
    parameter \Y_WIDTH 1
    connect \A 1'0
    connect \Y \multi
  end
  attribute \src "test.v:8.1-8.30"
  cell $dlatch \l1
    parameter \EN_POLARITY 1
    parameter \WIDTH 1
    connect \EN 1'1
    connect \D \multi
    connect \Q \y
  end
end
EOF

logger -expect prefix-warning "test.v:3: Warning: Wire top.undriven is used but has no driver." 1
logger -expect prefix-warning "test.v:4: Warning: multiple conflicting drivers for top.multi:" 1
logger -expect prefix-warning "test.v:8: Warning: Cell top.l1 is a latch of type \\$dlatch." 1
logger -nowarn "Drivers conflicting"
check -nolatches
